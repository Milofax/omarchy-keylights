#!/usr/bin/env bash
set -uo pipefail

readonly API_ROOT="/elgato"
readonly API_PATH="$API_ROOT/lights"
readonly INFO_PATH="$API_ROOT/accessory-info"
readonly MAX_PARALLEL=8
if [[ -n "${XDG_CONFIG_HOME:-}" ]]; then
  default_preferences_file="$XDG_CONFIG_HOME/omarchy/keylights/preferences.json"
elif [[ -n "${HOME:-}" ]]; then
  default_preferences_file="$HOME/.config/omarchy/keylights/preferences.json"
else
  default_preferences_file=""
fi
readonly PREFERENCES_FILE="${KEYLIGHTS_PREFERENCES_FILE:-$default_preferences_file}"
unset default_preferences_file

usage() {
  cat <<'EOF'
Usage:
  keylights json
  keylights setup
  keylights control ACTION VALUE TARGETS_JSON
  keylights preferences set DEVICE_ID DISCOVERY_ID POSITION NAME
  keylights preferences clear DEVICE_ID
  keylights preferences prompt DEVICE_ID DISCOVERY_ID POSITION CURRENT_NAME
  keylights preferences order LIGHTS_JSON
  keylights [all|DEVICE_ID] status
  keylights [all|DEVICE_ID] on|off|toggle
  keylights [all|DEVICE_ID] brightness <1-100>
  keylights [all|DEVICE_ID] temperature <2900-7000>

DEVICE_ID and DISCOVERY_ID values are returned by `keylights json`.
POSITION is an integer from 0 through 9999. NAME must contain 1-64 characters;
quote it when it contains spaces.
EOF
}

require_runtime() {
  local command_name
  for command_name in curl jq; do
    command -v "$command_name" >/dev/null || {
      printf 'Required command not found: %s\n' "$command_name" >&2
      return 3
    }
  done
}

decode_avahi() {
  local value="$1" escape digits decimal encoded decoded

  while [[ "$value" =~ \\([0-9]{3}) ]]; do
    escape="${BASH_REMATCH[0]}"
    digits="${BASH_REMATCH[1]}"
    decimal=$((10#$digits))
    (( decimal > 0 && decimal <= 255 )) || break
    printf -v encoded '\\%03o' "$decimal"
    printf -v decoded '%b' "$encoded"
    value="${value/"$escape"/"$decoded"}"
  done
  printf '%s' "$value"
}

valid_ipv4() {
  local address="$1" octet first second
  local -a octets

  [[ "$address" =~ ^[0-9]+(\.[0-9]+){3}$ ]] || return 1
  IFS=. read -r -a octets <<<"$address"
  for octet in "${octets[@]}"; do
    [[ "$octet" =~ ^[0-9]+$ ]] && (( 10#$octet <= 255 )) || return 1
  done

  first=$((10#${octets[0]}))
  second=$((10#${octets[1]}))
  case "$first" in
    10) return 0 ;;
    172) (( second >= 16 && second <= 31 )) ;;
    192) (( second == 168 )) ;;
    169) (( second == 254 )) ;;
    *) return 1 ;;
  esac
}

valid_port() {
  [[ "$1" =~ ^[0-9]+$ ]] && (( 10#$1 >= 1 && 10#$1 <= 65535 ))
}

valid_device_id() {
  [[ "$1" =~ ^[[:alnum:]][[:alnum:]_.:-]{0,127}$ ]]
}

valid_preference_name() {
  [[ ${#1} -le 64 && "$1" =~ [^[:space:]] && ! "$1" =~ [[:cntrl:]] ]]
}

load_preferences() {
  local preferences_file="${1:-$PREFERENCES_FILE}"
  if [[ -z "$preferences_file" || ! -e "$preferences_file" ]]; then
    printf '%s\n' '{"version":1,"lights":{}}'
    return
  fi

  jq -ce '
    select(.version == 1)
    | select((.lights | type) == "object")
    | select(all(.lights[];
        (.name | type) == "string" and (.name | length) > 0 and
        (.order | type) == "number" and (.order | floor) == .order and .order >= 0 and
        ((.discoveryId == null) or ((.discoveryId | type) == "string" and (.discoveryId | length) > 0))
      ))
  ' "$preferences_file" || {
    printf 'Invalid Key Lights preferences: %s\n' "$preferences_file" >&2
    return 2
  }
}

preferences_write_path() {
  if [[ -z "$PREFERENCES_FILE" ]]; then
    printf 'XDG_CONFIG_HOME or HOME is required to save Key Lights preferences.\n' >&2
    return 2
  fi
  if [[ -L "$PREFERENCES_FILE" ]]; then
    printf 'Refusing to write Key Lights preferences through a symlink: %s\n' "$PREFERENCES_FILE" >&2
    return 2
  fi
  printf '%s\n' "$PREFERENCES_FILE"
}

save_preference() (
  local id="$1" discovery_id="$2" order="$3" name="$4"
  local preferences preferences_file directory temporary order_number
  if ! valid_device_id "$id" || ! valid_device_id "$discovery_id" ||
      [[ ! "$order" =~ ^[0-9]{1,4}$ ]] || ! valid_preference_name "$name"; then
    printf 'Invalid Key Light preference.\n' >&2
    return 2
  fi
  order_number=$((10#$order))

  preferences_file="$(preferences_write_path)" || return $?
  directory="$(dirname -- "$preferences_file")"
  umask 077
  mkdir -p -- "$directory" || return 1
  exec 9<"$directory" || return 1
  flock -x 9 || return 1
  preferences="$(load_preferences "$preferences_file")" || return $?
  temporary="$(mktemp --tmpdir="$directory" .preferences.XXXXXX)" || return 1
  trap 'rm -f -- "$temporary"' EXIT
  jq -cn --argjson preferences "$preferences" --arg id "$id" --arg discoveryId "$discovery_id" --arg name "$name" \
    --argjson order "$order_number" \
    '$preferences | .lights[$id] = {discoveryId:$discoveryId, name:$name, order:$order}' >"$temporary" || return 1
  chmod 0600 "$temporary" || return 1
  mv -f -- "$temporary" "$preferences_file" || return 1
  trap - EXIT
)

clear_preference() (
  local id="$1" preferences preferences_file directory temporary
  valid_device_id "$id" || {
    printf 'Invalid Key Light device ID.\n' >&2
    return 2
  }

  preferences_file="$(preferences_write_path)" || return $?
  directory="$(dirname -- "$preferences_file")"
  umask 077
  mkdir -p -- "$directory" || return 1
  exec 9<"$directory" || return 1
  flock -x 9 || return 1
  preferences="$(load_preferences "$preferences_file")" || return $?
  temporary="$(mktemp --tmpdir="$directory" .preferences.XXXXXX)" || return 1
  trap 'rm -f -- "$temporary"' EXIT
  jq -cn --argjson preferences "$preferences" --arg id "$id" \
    '$preferences | del(.lights[$id])' >"$temporary" || return 1
  chmod 0600 "$temporary" || return 1
  mv -f -- "$temporary" "$preferences_file" || return 1
  trap - EXIT
)

save_preference_order() (
  local lights="$1" preferences preferences_file directory temporary
  jq -e '
    . as $lights
    | ($lights | type) == "array" and ($lights | length) > 0 and ($lights | length) <= 100 and
    (($lights | map(.id) | unique | length) == ($lights | length)) and
    all($lights[];
      (.id | type) == "string" and (.id | test("^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$")) and
      (.discoveryId | type) == "string" and (.discoveryId | test("^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$")) and
      (.name | type) == "string" and (.name | length) > 0 and (.name | length) <= 64 and
      (.name | test("[^[:space:]]")) and (.name | explode | all(. >= 32 and . != 127))
    )
  ' <<<"$lights" >/dev/null || {
    printf 'Invalid Key Light order data.\n' >&2
    return 2
  }

  preferences_file="$(preferences_write_path)" || return $?
  directory="$(dirname -- "$preferences_file")"
  umask 077
  mkdir -p -- "$directory" || return 1
  exec 9<"$directory" || return 1
  flock -x 9 || return 1
  preferences="$(load_preferences "$preferences_file")" || return $?
  temporary="$(mktemp --tmpdir="$directory" .preferences.XXXXXX)" || return 1
  trap 'rm -f -- "$temporary"' EXIT
  jq -cn --argjson preferences "$preferences" --argjson lights "$lights" '
    reduce range(0; $lights | length) as $index ($preferences;
      ($lights[$index]) as $light
      | .lights[$light.id] = {
          discoveryId: $light.discoveryId,
          name: $light.name,
          order: $index
        }
    )
  ' >"$temporary" || return 1
  chmod 0600 "$temporary" || return 1
  mv -f -- "$temporary" "$preferences_file" || return 1
  trap - EXIT
)

prompt_preference() {
  local id="$1" discovery_id="$2" order="$3" current_name="$4" name
  command -v zenity >/dev/null || {
    printf 'Zenity is required to rename a Key Light from the panel.\n' >&2
    return 3
  }
  name="$(zenity --entry --title='Rename Key Light' --text='Choose a local name for this light' \
    --entry-text="$current_name")" || return 0
  save_preference "$id" "$discovery_id" "$order" "$name"
}

apply_preferences() {
  local lights="$1" preferences
  preferences="$(load_preferences 2>/dev/null)" || preferences='{"version":1,"lights":{}}'
  jq -cn --argjson lights "$lights" --argjson preferences "$preferences" '
    ($preferences.lights | to_entries) as $saved
    | [$lights[]
        | . as $light
        | ($saved
            | map(select(.key == $light.id or ((.value.discoveryId // "") == $light.discoveryId)))
            | first // null
          ) as $savedLight
        | ($savedLight.value // {}) as $preference
        | . + {
            id: ($savedLight.key // .id),
            originalName: .name,
            name: (if ($preference.name | type) == "string" then $preference.name else .name end),
            preferenceOrder: (if ($preference.order | type) == "number" then $preference.order else 10000 end)
          }
      ] as $discovered
    | $discovered + [
        $saved[]
        | select(.key as $id | ($discovered | any(.id == $id)) | not)
        | {
            id: .key,
            discoveryId: (.value.discoveryId // .key),
            name: .value.name,
            originalName: .value.name,
            preferenceOrder: .value.order,
            reachable: false,
            on: 0
          }
      ]
    | sort_by(.preferenceOrder, .name, .id)
  '
}

discover_rows() {
  local browse_output

  command -v avahi-browse >/dev/null || {
    printf 'Avahi discovery is not installed.\n' >&2
    return 3
  }

  if ! browse_output="$(avahi-browse -rcp _elg._tcp 2>/dev/null)"; then
    printf 'Avahi discovery failed.\n' >&2
    return 3
  fi

  while IFS=';' read -r marker _interface protocol service_name _service_type _domain host address port txt; do
    [[ "$marker" == '=' && "$protocol" == IPv4 ]] || continue
    if ! valid_ipv4 "$address" || ! valid_port "$port"; then continue; fi

    local name id
    name="$(decode_avahi "$service_name")"
    id="$(sed -n 's/.*"id=\([^"]*\)".*/\1/p' <<<"$txt")"
    [[ -n "$id" ]] || id="$host"
    name="${name//$'\t'/ }"
    name="${name//$'\r'/ }"
    name="${name//$'\n'/ }"
    id="${id//$'\t'/ }"
    id="${id//$'\r'/ }"
    id="${id//$'\n'/ }"
    printf '%s\t%s\t%s\t%s\t%s\n' "$id" "$name" "$address" "$port" "$host"
  done <<<"$browse_output" | awk -F '\t' '!seen[$1]++'
}

setup_supported() {
  command -v nmcli >/dev/null && command -v zenity >/dev/null && command -v xdg-open >/dev/null
}

setup_available() {
  setup_supported || return 1
  nmcli -t --escape no -f SSID device wifi list --rescan no 2>/dev/null |
    grep -Eq '^Elgato (Key|Ring) Light([[:space:]]|$)'
}

request_path() (
  local profile="$1" method="$2" address="$3" port="$4" path="$5" payload="${6:-}"
  local response_file curl_status=1 attempt attempt_limit=1
  local -a args=(
    --disable
    --fail --silent --show-error
    --noproxy '*'
  )

  case "$profile" in
    robust)
      args+=(
        --connect-timeout 0.75 --max-time 1.5
        --retry 4 --retry-delay 0 --retry-max-time 6 --retry-all-errors
      )
      ;;
    control)
      args+=(
        --connect-timeout 0.75 --max-time 1
        --retry 0
      )
      attempt_limit=2
      ;;
    *)
      printf 'Unknown request profile: %s\n' "$profile" >&2
      return 2
      ;;
  esac
  args+=(--request "$method")

  valid_ipv4 "$address" && valid_port "$port" || return 2
  if [[ -n "$payload" ]]; then
    args+=(--header 'Content-Type: application/json' --data "$payload")
  fi

  response_file="$(mktemp --tmpdir keylights-response.XXXXXX)" || return 1
  trap 'rm -f -- "$response_file"' EXIT
  trap 'exit 129' HUP
  trap 'exit 130' INT
  trap 'exit 143' TERM

  for ((attempt = 1; attempt <= attempt_limit; attempt++)); do
    if curl "${args[@]}" --output "$response_file" "http://${address}:${port}${path}"; then
      cat -- "$response_file"
      return
    else
      curl_status=$?
    fi
  done
  return "$curl_status"
)

read_info() {
  local profile="$1" address="$2" port="$3"
  request_path "$profile" GET "$address" "$port" "$INFO_PATH" |
    jq -ce '
      select((.productName | type) == "string")
      | select(.productName | startswith("Elgato "))
      | select((.features | type) == "array" and (.features | index("lights")) != null)
    '
}

read_state() {
  local profile="$1" address="$2" port="$3"
  request_path "$profile" GET "$address" "$port" "$API_PATH" | jq -ce '.lights[0]'
}

set_state() {
  local profile="$1" address="$2" port="$3" payload="$4"
  request_path "$profile" PUT "$address" "$port" "$API_PATH" \
    "$(jq -cn --argjson light "$payload" '{numberOfLights: 1, lights: [$light]}')" |
    jq -ce '.lights[0]'
}

validate_action() {
  local action="$1" value="${2:-}"

  case "$action" in
    status|on|off|toggle)
      [[ -z "$value" ]] || return 2
      ;;
    brightness)
      [[ "$value" =~ ^[0-9]+$ ]] && (( value >= 1 && value <= 100 )) || return 2
      ;;
    temperature)
      [[ "$value" =~ ^[0-9]+$ ]] && (( value >= 2900 && value <= 7000 )) || return 2
      ;;
    *) return 2 ;;
  esac
}

perform_action() {
  local profile="$1" address="$2" port="$3" action="$4" value="${5:-}"
  local current payload

  case "$action" in
    status)
      read_state "$profile" "$address" "$port"
      ;;
    on|off)
      [[ "$action" == on ]] && payload='{"on":1}' || payload='{"on":0}'
      set_state "$profile" "$address" "$port" "$payload"
      ;;
    toggle)
      current="$(read_state "$profile" "$address" "$port")" || return 1
      [[ "$(jq -r '.on' <<<"$current")" == 1 ]] && payload='{"on":0}' || payload='{"on":1}'
      set_state "$profile" "$address" "$port" "$payload"
      ;;
    brightness)
      payload="$(jq -cn --argjson brightness "$value" '{brightness:$brightness}')"
      set_state "$profile" "$address" "$port" "$payload"
      ;;
    temperature)
      local mired=$(((1000000 + value / 2) / value))
      (( mired > 344 )) && mired=344
      (( mired < 143 )) && mired=143
      payload="$(jq -cn --argjson temperature "$mired" '{temperature:$temperature}')"
      set_state "$profile" "$address" "$port" "$payload"
      ;;
  esac
}

probe_device() {
  local advertised_id="$1" name="$2" address="$3" port="$4" host="$5"
  local info state id product

  if info="$(read_info robust "$address" "$port" 2>/dev/null)"; then
    id="$(jq -r '.serialNumber // empty' <<<"$info")"
    product="$(jq -r '.productName' <<<"$info")"
    [[ -n "$id" ]] || id="$advertised_id"
    if state="$(read_state robust "$address" "$port" 2>/dev/null)"; then
      jq -cn \
        --arg id "$id" --arg name "$name" --arg product "$product" --arg host "$host" \
        --arg address "$address" --argjson port "$port" --argjson state "$state" \
        --arg discoveryId "$advertised_id" \
        '$state + {id:$id,discoveryId:$discoveryId,name:$name,product:$product,host:$host,address:$address,port:$port,reachable:true}'
      return
    fi
  else
    id="$advertised_id"
    product=""
  fi

  jq -cn \
    --arg id "$id" --arg name "$name" --arg product "$product" --arg host "$host" \
    --arg address "$address" --argjson port "$port" \
    --arg discoveryId "$advertised_id" \
    '{id:$id,discoveryId:$discoveryId,name:$name,product:$product,host:$host,address:$address,port:$port,reachable:false}'
}

json_status() (
  local rows setup=false supported=false work_dir output_file lights='[]'
  local id name address port host index=0 pid_index
  local -a pids=() files=()

  setup_supported && supported=true
  setup_available && setup=true

  if ! rows="$(discover_rows)"; then
    jq -cn --argjson setup "$setup" --argjson supported "$supported" \
      --arg error 'Could not discover Key Lights through mDNS.' \
      '{lights:[],setupAvailable:$setup,setupSupported:$supported,error:$error}'
    return 3
  fi

  work_dir="$(mktemp -d)" || return 1
  trap 'rm -rf -- "$work_dir"' EXIT
  while IFS=$'\t' read -r id name address port host; do
    [[ -n "$id" ]] || continue
    index=$((index + 1))
    output_file="$work_dir/$index.json"
    files+=("$output_file")
    probe_device "$id" "$name" "$address" "$port" "$host" >"$output_file" &
    pids+=("$!")
    if (( ${#pids[@]} >= MAX_PARALLEL )); then
      for pid_index in "${!pids[@]}"; do
        wait "${pids[$pid_index]}" || true
      done
      pids=()
    fi
  done <<<"$rows"

  for pid_index in "${!pids[@]}"; do
    wait "${pids[$pid_index]}" || true
  done

  if (( ${#files[@]} > 0 )); then
    lights="$(jq -sc '.' "${files[@]}")" || return 1
  fi
  lights="$(apply_preferences "$lights")" || return $?

  jq -cn --argjson lights "$lights" --argjson setup "$setup" --argjson supported "$supported" \
    '{lights:$lights,setupAvailable:$setup,setupSupported:$supported,error:null}'
)

validate_targets() {
  local targets="$1" address port

  jq -e '
    type == "array" and length > 0 and all(.[];
      (.id | type) == "string" and (.id | length) > 0 and
      (.discoveryId | type) == "string" and (.discoveryId | length) > 0 and
      (.name | type) == "string" and
      (.address | type) == "string" and
      (.port | type) == "number" and (.port | floor) == .port
    )
  ' <<<"$targets" >/dev/null || return 2

  while IFS=$'\t' read -r address port; do
    valid_ipv4 "$address" && valid_port "$port" || return 2
  done < <(jq -r '.[] | [.address, (.port | tostring)] | @tsv' <<<"$targets")
}

control_target() {
  local id="$1" discovery_id="$2" name="$3" address="$4" port="$5" action="$6" value="$7"
  local state

  if state="$(perform_action control "$address" "$port" "$action" "$value" 2>/dev/null)"; then
    jq -cn \
      --arg id "$id" --arg discoveryId "$discovery_id" --arg name "$name" \
      --arg address "$address" --argjson port "$port" \
      --argjson state "$state" \
      '$state + {id:$id,discoveryId:$discoveryId,name:$name,address:$address,port:$port,reachable:true,ok:true}'
    return
  fi

  jq -cn \
    --arg id "$id" --arg discoveryId "$discovery_id" --arg name "$name" \
    --arg address "$address" --argjson port "$port" \
    '{id:$id,discoveryId:$discoveryId,name:$name,address:$address,port:$port,reachable:false,ok:false,error:"Device did not respond."}'
  return 1
}

control_targets() (
  local action="$1" value="$2" targets="$3" work_dir output_file
  local id discovery_id name address port index=0 pid_index failures=0 status
  local -a pids=() files=()

  [[ "$value" == '-' ]] && value=""
  validate_action "$action" "$value" || {
    printf 'Invalid action or value.\n' >&2
    return 2
  }
  validate_targets "$targets" || {
    printf 'Invalid control target data.\n' >&2
    return 2
  }

  work_dir="$(mktemp -d)" || return 1
  trap 'rm -rf -- "$work_dir"' EXIT
  while IFS=$'\t' read -r id discovery_id name address port; do
    index=$((index + 1))
    output_file="$work_dir/$index.json"
    files+=("$output_file")
    control_target "$id" "$discovery_id" "$name" "$address" "$port" "$action" "$value" >"$output_file" &
    pids+=("$!")
    if (( ${#pids[@]} >= MAX_PARALLEL )); then
      for pid_index in "${!pids[@]}"; do
        status=0
        wait "${pids[$pid_index]}" || status=$?
        (( status == 0 )) || failures=$((failures + 1))
      done
      pids=()
    fi
  done < <(jq -r '.[] | [.id, .discoveryId, .name, .address, (.port | tostring)] | @tsv' <<<"$targets")

  for pid_index in "${!pids[@]}"; do
    status=0
    wait "${pids[$pid_index]}" || status=$?
    (( status == 0 )) || failures=$((failures + 1))
  done

  jq -sc --argjson failures "$failures" '{results:.,failures:$failures}' "${files[@]}"
  (( failures == 0 ))
)

describe_result() {
  jq -r '
    .results[] |
    if .ok then
      "\(.name): \(if .on == 1 then "on" else "off" end), "
      + (if (.brightness | type) == "number" then "\(.brightness)%" else "brightness unavailable" end)
      + ", "
      + (if (.temperature | type) == "number" and .temperature > 0
         then "\((1000000 / .temperature) | round) K"
         else "temperature unavailable"
         end)
    else
      "\(.name): did not respond"
    end
  '
}

run_discovered_action() {
  local target="$1" action="$2" value="$3" rows targets result status=0
  local id stable_id name address port host info

  validate_action "$action" "$value" || {
    printf 'Invalid action or value.\n' >&2
    usage >&2
    return 2
  }
  rows="$(discover_rows)" || return $?
  targets='[]'

  while IFS=$'\t' read -r id name address port host; do
    [[ -n "$id" ]] || continue
    info="$(read_info control "$address" "$port" 2>/dev/null)" || continue
    stable_id="$(jq -r '.serialNumber // empty' <<<"$info")"
    [[ -n "$stable_id" ]] || stable_id="$id"
    targets="$(jq -cn --argjson targets "$targets" --arg id "$stable_id" --arg discoveryId "$id" --arg name "$name" \
      --arg address "$address" --argjson port "$port" \
      '$targets + [{id:$id,discoveryId:$discoveryId,name:$name,address:$address,port:$port}]')"
  done <<<"$rows"

  targets="$(apply_preferences "$targets")" || return $?
  if [[ "$target" != all ]]; then
    targets="$(jq -c --arg target "$target" \
      '[.[] | select(.id == $target or .discoveryId == $target or .name == $target)]' <<<"$targets")" || return 1
  fi

  if [[ "$(jq 'length' <<<"$targets")" == 0 ]]; then
    printf 'No matching Key Light was found.\n' >&2
    return 1
  fi

  result="$(control_targets "$action" "${value:--}" "$targets")" || status=$?
  describe_result <<<"$result"
  return "$status"
}

restore_network() {
  local wifi_device="$1" previous_connection_uuid="$2"

  if [[ -n "$previous_connection_uuid" && "$previous_connection_uuid" != '--' ]]; then
    nmcli --wait 20 connection up uuid "$previous_connection_uuid" ifname "$wifi_device" >/dev/null 2>&1
  else
    nmcli --wait 10 device disconnect "$wifi_device" >/dev/null 2>&1
  fi
}

setup_flow() {
  wifi_device=""
  networks=""
  selected=""
  previous_connection_uuid=""
  profiles_before=""
  light_connection_uuid=""
  connect_status=0
  restore_needed=false
  temporary_profile=false

  # shellcheck disable=SC2329
  finish_setup() {
    local status=$?
    trap - EXIT HUP INT TERM
    if [[ "$restore_needed" == true ]] && ! restore_network "$wifi_device" "$previous_connection_uuid"; then
      zenity --error --title='Set up Key Lights' \
        --text='The previous network connection could not be restored. Reconnect from the network menu.' || true
      status=1
    fi
    if [[ "$temporary_profile" == true ]] &&
        ! nmcli --wait 10 connection delete uuid "$light_connection_uuid" >/dev/null 2>&1; then
      zenity --error --title='Set up Key Lights' \
        --text='The temporary Elgato Wi-Fi profile could not be removed. Remove it from the network menu.' || true
      status=1
    fi
    exit "$status"
  }
  trap finish_setup EXIT
  trap 'exit 130' HUP INT TERM

  setup_supported || {
    zenity --error --title='Set up Key Lights' \
      --text='NetworkManager, Zenity, and a browser are required for setup.' 2>/dev/null || true
    return 1
  }

  wifi_device="$(nmcli -t -f DEVICE,TYPE device status | awk -F: '$2 == "wifi" { print $1; exit }')"
  if [[ -z "$wifi_device" ]]; then
    zenity --error --title='Set up Key Lights' --text='No Wi-Fi adapter was found.'
    return 1
  fi

  nmcli device wifi rescan ifname "$wifi_device" >/dev/null 2>&1 || true
  networks="$(
    nmcli -t --escape no -f SSID,SIGNAL device wifi list ifname "$wifi_device" --rescan yes |
      awk -F: '$1 ~ /^Elgato (Key|Ring) Light([[:space:]]|$)/ { print $1 "\t" $2 }' |
      sort -u |
      awk -F '\t' '{ print $1; print $2 }'
  )"

  if [[ -z "$networks" ]]; then
    zenity --info --title='Set up Key Lights' --width=460 \
      --text='No unconfigured Elgato light was found.\n\nHold RESET for at least 10 seconds until the light flashes three times. Wait a moment, then run “Set up” again.'
    return 0
  fi

  selected="$(
    printf '%s\n' "$networks" |
      zenity --list --title='Set up Key Lights' --width=460 --height=300 \
        --text='Choose the flashing light to set up' \
        --column='Elgato Wi-Fi' --column='Signal' --print-column=1
  )" || return 0
  [[ "$selected" =~ ^Elgato\ (Key|Ring)\ Light\ [[:alnum:]_-]+(\ [[:alnum:]_-]+)*$ ]] || return 1

  previous_connection_uuid="$(nmcli -g GENERAL.CON-UUID device show "$wifi_device" 2>/dev/null || true)"
  profiles_before="$(nmcli -t -f UUID connection show 2>/dev/null || true)"
  restore_needed=true
  nmcli --wait 20 device wifi connect "$selected" ifname "$wifi_device" >/dev/null || connect_status=$?

  light_connection_uuid="$(nmcli -g GENERAL.CON-UUID device show "$wifi_device" 2>/dev/null || true)"
  if [[ -z "$light_connection_uuid" || "$light_connection_uuid" == '--' ]] ||
      grep -Fxq "$light_connection_uuid" <<<"$profiles_before"; then
    while IFS= read -r profile_uuid; do
      [[ -n "$profile_uuid" ]] || continue
      grep -Fxq "$profile_uuid" <<<"$profiles_before" && continue
      profile_ssid="$(nmcli -g 802-11-wireless.ssid connection show uuid "$profile_uuid" 2>/dev/null || true)"
      [[ "$profile_ssid" == "$selected" ]] || continue
      light_connection_uuid="$profile_uuid"
      break
    done < <(nmcli -t -f UUID connection show 2>/dev/null || true)
  fi
  if [[ -n "$light_connection_uuid" && "$light_connection_uuid" != '--' ]] &&
      ! grep -Fxq "$light_connection_uuid" <<<"$profiles_before"; then
    temporary_profile=true
  fi

  if (( connect_status != 0 )); then
    zenity --error --title='Set up Key Lights' --text='Could not connect directly to the light.'
    return 1
  fi

  if ! read_info robust 192.168.62.1 9123 >/dev/null 2>&1 ||
      ! read_state robust 192.168.62.1 9123 >/dev/null 2>&1; then
    zenity --error --title='Set up Key Lights' \
      --text='The selected Wi-Fi network did not expose a compatible Elgato light. No credentials were entered.'
    return 1
  fi

  zenity --question --title='Set up Key Lights' --width=520 \
    --text='The light provides its setup page over local, unencrypted HTTP. Continue only if the physical light you reset is flashing and the selected Wi-Fi name matches it.' \
    --ok-label='Open setup page' --cancel-label='Cancel' || return 0

  xdg-open 'http://192.168.62.1:9123/' >/dev/null 2>&1 &
  zenity --info --title='Set up Key Lights' --width=520 \
    --text='Enter the destination Wi-Fi name, password, and security mode on the Elgato page. Click Connect there, then click OK here.'

  notify-send --app-name='Key Lights' 'Key Lights' \
    'Setup complete. Discovery may take up to 60 seconds.' 2>/dev/null || true
}

main() {
  require_runtime || return $?

  case "${1:-}" in
    json)
      (( $# == 1 )) || { usage >&2; return 2; }
      json_status
      return
      ;;
    setup)
      (( $# == 1 )) || { usage >&2; return 2; }
      setup_flow
      return
      ;;
    control)
      (( $# == 4 )) || { printf 'Invalid control request.\n' >&2; return 2; }
      control_targets "$2" "$3" "$4"
      return
      ;;
    preferences)
      case "${2:-}" in
        set)
          (( $# == 6 )) || { usage >&2; return 2; }
          save_preference "$3" "$4" "$5" "$6"
          return
          ;;
        clear)
          (( $# == 3 )) || { usage >&2; return 2; }
          clear_preference "$3"
          return
          ;;
        prompt)
          (( $# == 6 )) || { usage >&2; return 2; }
          prompt_preference "$3" "$4" "$5" "$6"
          return
          ;;
        order)
          (( $# == 3 )) || { usage >&2; return 2; }
          save_preference_order "$3"
          return
          ;;
        *)
          usage >&2
          return 2
          ;;
      esac
      ;;
    -h|--help|help)
      usage
      return
      ;;
  esac

  local target="${1:-all}"
  local action="${2:-status}"
  local value="${3:-}"
  (( $# <= 3 )) || { usage >&2; return 2; }
  run_discovered_action "$target" "$action" "$value"
}

main "$@"
