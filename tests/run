#!/usr/bin/env bash
set -euo pipefail

root="$(cd "$(dirname "$0")/.." && pwd)"
work_dir="$(mktemp -d)"
fake_bin="$work_dir/bin"
state_file="$work_dir/state.json"
setup_log="$work_dir/setup-log"
setup_pid=""
runtime_pid=""
export KEYLIGHTS_PREFERENCES_FILE="$work_dir/default-preferences.json"

cleanup() {
  if [[ -n "$setup_pid" ]]; then kill -TERM -- "-$setup_pid" 2>/dev/null || true; fi
  if [[ -n "$runtime_pid" ]]; then kill -TERM -- "-$runtime_pid" 2>/dev/null || true; fi
  rm -r -- "$work_dir"
}
trap cleanup EXIT

fail() {
  printf 'Test failed: %s\n' "$*" >&2
  exit 1
}

assert_jq() {
  local json="$1" expression="$2" message="$3"
  jq -e "$expression" <<<"$json" >/dev/null || fail "$message"
}

for required_command in shellcheck node rg qmllint gdbus dbus-run-session flock; do
  command -v "$required_command" >/dev/null || fail "required development command is missing: $required_command"
done

payload_dir="$work_dir/plugin-payload"
mkdir -p "$payload_dir/bin" "$payload_dir/icons"
for release_file in LICENSE README.md Panel.qml LightControlRow.qml KeyLightsLogic.js manifest.json \
    bin/keylights bin/keylights-tray icons/io.github.milofax.keylights-symbolic.svg \
    preview.png; do
  [[ -f "$root/$release_file" && ! -L "$root/$release_file" ]] || \
    fail "release payload file is missing or a symlink: $release_file"
done
cp "$root/LICENSE" "$root/README.md" "$root/Panel.qml" "$root/LightControlRow.qml" "$root/KeyLightsLogic.js" \
  "$root/manifest.json" "$payload_dir/"
cp "$root/bin/keylights" "$root/bin/keylights-tray" "$payload_dir/bin/"
cp "$root/icons/io.github.milofax.keylights-symbolic.svg" "$payload_dir/icons/"
cp "$root/preview.png" "$payload_dir/"

bash -n "$root/bin/keylights"
shellcheck "$root/bin/keylights"
bash -n "$root/tests/toggle-latency"
shellcheck "$root/tests/toggle-latency"
shellcheck "$root/tests/run"
PYTHONPYCACHEPREFIX="$work_dir/pycache" python3 -m py_compile "$root/bin/keylights-tray"
PYTHONPYCACHEPREFIX="$work_dir/pycache" python3 -m py_compile "$root/tests/tray-restart-repro.py"
jq empty "$root/manifest.json"
omarchy plugin validate "$payload_dir"
qmllint -I /usr/share/omarchy/shell "$root/Panel.qml" >"$work_dir/qmllint.log" 2>&1 || \
  fail 'qmllint rejected Panel.qml'
qmllint -I /usr/share/omarchy/shell "$root/LightControlRow.qml" >>"$work_dir/qmllint.log" 2>&1 || \
  fail 'qmllint rejected LightControlRow.qml'
env -u DISPLAY -u QT_QPA_PLATFORMTHEME QT_QPA_PLATFORM=offscreen \
  QT_QUICK_BACKEND=software QT_STYLE_OVERRIDE=Basic \
  /usr/lib/qt6/bin/qmltestrunner -input "$root/tests/qml" || \
  fail 'the rendered light-row interaction tests failed'
env -u HOME -u XDG_CONFIG_HOME -u KEYLIGHTS_PREFERENCES_FILE \
  "$root/bin/keylights" --help >/dev/null || fail 'the CLI required HOME even when no preferences were being saved'

node - "$root/KeyLightsLogic.js" <<'EOF'
const assert = require("node:assert/strict")
const Logic = require(process.argv[2])

const on = [{id: "SERIAL-1", discoveryId: "discovery-1", reachable: true, on: 1, brightness: 20, temperature: 220}]
const off = [{id: "SERIAL-1", discoveryId: "discovery-1", reachable: true, on: 0, brightness: 20, temperature: 220}]
const unreachable = [{id: "discovery-1", discoveryId: "discovery-1", reachable: false, on: 0}]
const mixed = [
  {id: "SERIAL-1", reachable: true, on: 1, brightness: 20, temperature: 200},
  {id: "SERIAL-2", reachable: true, on: 0, brightness: 80, temperature: 250},
]

assert.equal(Logic.barVisible(on), true)
assert.equal(Logic.trayWanted(on), false)
assert.equal(Logic.barVisible(off), false)
assert.equal(Logic.trayWanted(off), true)
assert.equal(Logic.barVisible(unreachable), false)
assert.equal(Logic.trayWanted(unreachable), false)
assert.equal(Logic.trayWanted([]), false)
assert.deepEqual(Logic.advanceTrayMode(false, true, 0), {trayMode: false, confirmations: 1})
assert.deepEqual(Logic.advanceTrayMode(false, true, 1), {trayMode: true, confirmations: 0})
assert.deepEqual(Logic.advanceTrayMode(true, false, 0), {trayMode: false, confirmations: 0})
assert.equal(Logic.trayExitAction(3, false, true), "missing-dependency")
assert.equal(Logic.trayExitAction(5, false, true), "session-bus")
assert.equal(Logic.trayExitAction(4, false, true), "retry")
assert.equal(Logic.trayExitAction(1, false, true), "retry")
assert.equal(Logic.trayExitAction(1, true, true), "ignore")
assert.equal(Logic.connectionLost(off), false)
assert.equal(Logic.connectionLost(unreachable), true)
assert.equal(Logic.connectionLost(mixed), false)
assert.equal(Logic.connectionLost([]), false)
assert.equal(Logic.iconCrossed(unreachable, "", false), true)
assert.equal(Logic.iconCrossed([], "Discovery failed.", false), true)
assert.equal(Logic.iconCrossed([], "", false), true)
assert.equal(Logic.iconCrossed([], "", true), false)
assert.equal(Logic.setupVisible(false), false)
assert.equal(Logic.setupVisible(true), true)
assert.equal(Logic.shouldPoll(false, []), false)
assert.equal(Logic.shouldPoll(false, off), true)
assert.equal(Logic.shouldPoll(true, []), true)
assert.deepEqual(Logic.brightnessSummary(mixed), {value: 50, mixed: true})
assert.deepEqual(Logic.temperatureSummary(mixed), {value: 4500, mixed: true})

let fifo = Logic.enqueueCommand([], {action: "on"})
fifo = Logic.enqueueCommand(fifo, {action: "brightness"})
fifo = Logic.enqueueCommand(fifo, {action: "off"})
let nextCommand = Logic.dequeueCommand(fifo)
assert.equal(nextCommand.command.action, "on")
assert.deepEqual(nextCommand.remaining.map(command => command.action), ["brightness", "off"])

assert.equal(Logic.operationBusy(true, false, false, 0, false), true)
assert.equal(Logic.operationBusy(false, false, false, 0, true), true)
assert.equal(Logic.operationReady({}, true, false), false)
assert.equal(Logic.operationReady({}, false, true), false)
assert.equal(Logic.operationReady({}, true, true), true)

const reconciled = Logic.reconcileLights(on, unreachable)
assert.equal(reconciled[0].id, "SERIAL-1")
assert.equal(reconciled[0].discoveryId, "discovery-1")

const previouslyKnown = [
  {id: "SERIAL-1", discoveryId: "discovery-1", reachable: true, on: 0},
  {id: "SERIAL-2", discoveryId: "discovery-2", reachable: true, on: 0},
]
const partialDiscovery = Logic.reconcileLights(previouslyKnown, [previouslyKnown[0]])
assert.deepEqual(
  partialDiscovery.map(light => ({id: light.id, reachable: light.reachable})),
  [
    {id: "SERIAL-1", reachable: true},
    {id: "SERIAL-2", reachable: false},
  ],
)

const preferredPrevious = [
  {id: "SERIAL-1", discoveryId: "discovery-1", name: "Links", originalName: "Elgato Key Light 94D7", preferenceOrder: 0, reachable: true},
  {id: "SERIAL-2", discoveryId: "discovery-2", name: "Rechts", originalName: "Elgato Key Light 8C62", preferenceOrder: 1, reachable: true},
]
const rawPartial = [
  {id: "SERIAL-2", discoveryId: "discovery-2", name: "Rechts", originalName: "Elgato Key Light 8C62", preferenceOrder: 1, reachable: true},
  {id: "discovery-1", discoveryId: "discovery-1", name: "Elgato Key Light 94D7", preferenceOrder: 10000, reachable: false},
]
assert.deepEqual(
  Logic.reconcileLights(preferredPrevious, rawPartial).map(light => ({id: light.id, name: light.name, order: light.preferenceOrder, reachable: light.reachable})),
  [
    {id: "SERIAL-1", name: "Links", order: 0, reachable: false},
    {id: "SERIAL-2", name: "Rechts", order: 1, reachable: true},
  ],
)

const queued = [{targets: [{id: "SERIAL-1", discoveryId: "discovery-1", address: "10.0.0.99", port: 9123}]}]
const refreshed = Logic.refreshQueuedTargets(queued, [{id: "SERIAL-1", discoveryId: "discovery-1", address: "10.0.0.10", port: 9123, ok: true}])
assert.equal(refreshed[0].targets[0].address, "10.0.0.10")
assert.equal(Logic.actionError(2), "The Key Light command was rejected before contacting any device.")
assert.equal(Logic.actionError(1), "One or more lights did not respond. Please try again.")

const reordered = Logic.moveLight(preferredPrevious, 0, 1)
assert.deepEqual(reordered.map(light => light.id), ["SERIAL-2", "SERIAL-1"])
assert.deepEqual(preferredPrevious.map(light => light.id), ["SERIAL-1", "SERIAL-2"])
assert.equal(Logic.normalizedLightName("  Desk left  "), "Desk left")
assert.equal(Logic.normalizedLightName("   "), "")
EOF

"$root/tests/toggle-latency"
KEYLIGHTS_LATENCY_ACTION=off "$root/tests/toggle-latency"
KEYLIGHTS_LATENCY_ACTION=toggle KEYLIGHTS_LATENCY_MAXIMUM_MS=3000 \
  "$root/tests/toggle-latency"
KEYLIGHTS_LATENCY_FORCE_FAILURE=1 "$root/tests/toggle-latency"

tray_metadata="$(KEYLIGHTS_TRAY_TEST=metadata "$root/bin/keylights-tray")"
assert_jq "$tray_metadata" '.busName == "io.github.milofax.KeyLights.Tray"' 'tray helper does not use a stable duplicate-prevention bus name'
assert_jq "$tray_metadata" '.activate == "open" and .secondaryActivate == "toggleAll" and .contextMenu == "lightsOff"' \
  'tray helper IPC mapping is incomplete'
tray_retry="$(KEYLIGHTS_TRAY_TEST=watcher-retry "$root/bin/keylights-tray")"
assert_jq "$tray_retry" '.attempts == 3 and (.decisions | length) == 3 and .decisions[0] == true and .decisions[2] == false' \
  'tray watcher registration does not stop after its bounded retry budget'

if dbus-run-session -- python3 -c 'import dbus; dbus.SessionBus()' 2>/dev/null; then
  # shellcheck disable=SC2016
  dbus-run-session -- bash -euo pipefail -c '
  helper="$1"
  test_dir="$2"
  first_ready="$test_dir/tray-first-ready"
  standby_ready="$test_dir/tray-standby-ready"
  takeover_ready="$test_dir/tray-takeover-ready"
  object_ready="$test_dir/tray-object-ready"
  first_pid=""
  standby_pid=""
  object_pid=""
  cleanup_tray_test() {
    [[ -z "$first_pid" ]] || kill -TERM "$first_pid" 2>/dev/null || true
    [[ -z "$standby_pid" ]] || kill -TERM "$standby_pid" 2>/dev/null || true
    [[ -z "$object_pid" ]] || kill -TERM "$object_pid" 2>/dev/null || true
  }
  trap cleanup_tray_test EXIT

  KEYLIGHTS_TRAY_TEST=hold KEYLIGHTS_TRAY_READY="$first_ready" "$helper" &
  first_pid=$!
  for _ in {1..50}; do [[ -e "$first_ready" ]] && break; sleep 0.02; done
  [[ -e "$first_ready" ]]

  KEYLIGHTS_TRAY_TEST=hold KEYLIGHTS_TRAY_STANDBY_READY="$standby_ready" \
    KEYLIGHTS_TRAY_READY="$takeover_ready" "$helper" &
  standby_pid=$!
  for _ in {1..50}; do [[ -e "$standby_ready" ]] && break; sleep 0.02; done
  [[ -e "$standby_ready" ]]
  [[ ! -e "$takeover_ready" ]]
  kill -0 "$standby_pid"

  kill -TERM "$first_pid"
  wait "$first_pid"
  first_pid=""

  for _ in {1..50}; do [[ -e "$takeover_ready" ]] && break; sleep 0.02; done
  [[ -e "$takeover_ready" ]]
  kill -0 "$standby_pid"
  kill -TERM "$standby_pid"
  wait "$standby_pid"
  standby_pid=""

  KEYLIGHTS_TRAY_TEST=object KEYLIGHTS_TRAY_READY="$object_ready" "$helper" &
  object_pid=$!
  for _ in {1..50}; do [[ -e "$object_ready" ]] && break; sleep 0.02; done
  [[ -e "$object_ready" ]]
  item_id="$(gdbus call --session --dest io.github.milofax.KeyLights.Tray \
    --object-path /StatusNotifierItem --method org.freedesktop.DBus.Properties.Get \
    org.kde.StatusNotifierItem Id)"
  [[ "$item_id" == *io.github.milofax.keylights* ]]
  icon_name="$(gdbus call --session --dest io.github.milofax.KeyLights.Tray \
    --object-path /StatusNotifierItem --method org.freedesktop.DBus.Properties.Get \
    org.kde.StatusNotifierItem IconName)"
  [[ "$icon_name" == *io.github.milofax.keylights-symbolic* ]]
  kill -TERM "$object_pid"
  wait "$object_pid"
  object_pid=""
' _ "$root/bin/keylights-tray" "$work_dir"
  dbus-run-session -- python3 "$root/tests/tray-restart-repro.py"
elif [[ "${KEYLIGHTS_TEST_REQUIRE_DBUS:-0}" == 1 ]]; then
  fail 'an isolated writable session D-Bus is unavailable for the tray lifecycle tests'
else
  printf 'Skipping tray lifecycle tests: an isolated writable session D-Bus is unavailable.\n'
fi

[[ -x "$root/bin/keylights" ]] || fail 'bin/keylights is not executable'
[[ -x "$root/bin/keylights-tray" ]] || fail 'bin/keylights-tray is not executable'
[[ -f "$root/icons/io.github.milofax.keylights-symbolic.svg" ]] || fail 'tray icon asset is missing'
[[ -z "$(find "$payload_dir" -type l -print -quit)" ]] || fail 'release payload contains a symlink'

grep -q '"id": "io.github.milofax.keylights"' "$root/manifest.json"
grep -q '"version": "1.4.4"' "$root/manifest.json"
grep -q 'moduleName: "io.github.milofax.keylights"' "$root/Panel.qml"
grep -q 'ipcTarget: "io.github.milofax.keylights"' "$root/Panel.qml"
grep -Fq 'import "KeyLightsLogic.js" as Logic' "$root/Panel.qml"
grep -Fq 'visible: opened || !trayMode || trayUnavailable' "$root/Panel.qml"
grep -Fq 'property bool trayMode: false' "$root/Panel.qml"
grep -Fq 'readonly property bool trayWanted: Logic.trayWanted(lights)' "$root/Panel.qml"
grep -Fq 'Logic.advanceTrayMode(trayMode, trayWanted, trayWantedConfirmations)' "$root/Panel.qml"
grep -Fq 'Logic.trayExitAction(exitCode, trayStopRequested, trayMode)' "$root/Panel.qml"
grep -Fq 'trayRetryCount >= trayRetryLimit' "$root/Panel.qml"
grep -Fq 'System tray support stopped unexpectedly; tray support will retry.' "$root/Panel.qml"
grep -Fq 'stdout: SplitParser { onRead: function(line) { root.handleTrayOutput(line) } }' "$root/Panel.qml"
grep -Fq 'print("ready", flush=True)' "$root/bin/keylights-tray"
grep -Fq 'commandQueue = []' "$root/Panel.qml"
grep -Fq 'root.warningSummary !== "" ? root.warningSummary : root.stateSummary' "$root/Panel.qml"
grep -Fq 'root.saveLightName(light, rowIndex, name)' "$root/Panel.qml"
grep -Fq 'DragHandler {' "$root/LightControlRow.qml"
grep -Fq 'target: null' "$root/LightControlRow.qml"
grep -Fq 'root.moveLight(fromIndex, toIndex)' "$root/Panel.qml"
grep -Fq 'TextField {' "$root/LightControlRow.qml"
grep -Fq 'height: implicitHeight' "$root/LightControlRow.qml"
grep -Fq 'text: "✎"' "$root/LightControlRow.qml"
grep -Fq 'property color switchOnColor: "#4ade80"' "$root/LightControlRow.qml"
grep -Fq 'opened: root.opened' "$root/Panel.qml"
if grep -Fq '"preferences", "prompt"' "$root/Panel.qml"; then
  fail 'the plugin still delegates renaming to an external prompt'
fi
grep -Fq 'text: root.trayErrorText' "$root/Panel.qml"
grep -Fq 'running: Logic.shouldPoll(root.opened, root.lights)' "$root/Panel.qml"
grep -Fq 'property bool statusInFlight: false' "$root/Panel.qml"
grep -Fq 'Logic.operationReady(statusInFlight, statusExitReceived, statusOutputReceived)' "$root/Panel.qml"
grep -Fq 'onStreamFinished: root.handleStatusError(text)' "$root/Panel.qml"
grep -Fq 'command: [root.trayTool]' "$root/Panel.qml"
grep -Fq 'textFormat: Text.PlainText' "$root/Panel.qml"
grep -Fq 'pragma ComponentBehavior: Bound' "$root/Panel.qml"
grep -q 'property var commandQueue: \[\]' "$root/Panel.qml"
grep -Fq 'Logic.operationReady(activeCommand, actionExitReceived, actionOutputReceived)' "$root/Panel.qml"
grep -q 'onStreamFinished: root.handleActionOutput(text)' "$root/Panel.qml"
grep -q 'onExited: function(exitCode) { root.handleActionExit(exitCode) }' "$root/Panel.qml"
grep -Fq 'onStreamFinished: root.handleActionError(text)' "$root/Panel.qml"
grep -q 'Math.round(value / 100) \* 100' "$root/Panel.qml"
grep -q 'root.brightnessMixed ? "Mixed"' "$root/Panel.qml"
grep -q 'root.temperatureMixed ? "Mixed"' "$root/Panel.qml"
grep -q 'omarchy plugin remove io.github.milofax.keylights' "$root/README.md"
grep -Fq 'system-tray drawer' "$root/README.md"
grep -Eq 'python-dbus.*python-gobject' "$root/README.md"
grep -Fq './bin/keylights control ACTION VALUE TARGETS_JSON' "$root/README.md"
grep -Fq 'same-user IPC' "$root/README.md"
grep -Fq '](preview.png)' "$root/README.md"
grep -Fq 'notify-send' "$root/README.md"
grep -Fq 'private RFC 1918 or IPv4 link-local addresses' "$root/README.md"
grep -Fq 'limits every device response to 64 KiB' "$root/README.md"
grep -Fq -- \~/.config/omarchy/keylights/preferences.json "$root/README.md"
grep -Eq 'shellcheck.*node.*ripgrep.*qmllint.*gdbus.*Omarchy installation' "$root/README.md"
grep -Fq 'bar layout so this fallback remains reachable' "$root/README.md"
grep -q 'connection delete uuid' "$root/bin/keylights"

if rg -n --glob '!tests/run' '192\.168\.1\.|elgato-key-light-[0-9a-f]+\.local' "$root"; then
  fail 'private network details found in repository'
fi
if [[ -n "${KEYLIGHTS_TEST_PRIVATE_PATTERN:-}" ]] &&
    rg -n --glob '!tests/run' -- "$KEYLIGHTS_TEST_PRIVATE_PATTERN" "$root"; then
  fail 'locally configured private details found in repository'
fi

mkdir -p -- "$fake_bin"

cat >"$fake_bin/avahi-browse" <<'EOF'
#!/usr/bin/env bash
if [[ -n "${KEYLIGHT_TEST_AVAHI_LOG:-}" ]]; then printf 'called\n' >>"$KEYLIGHT_TEST_AVAHI_LOG"; fi
if [[ "${KEYLIGHT_TEST_AVAHI:-ok}" == fail ]]; then exit 1; fi
if [[ "${KEYLIGHT_TEST_ESCAPED_NAME:-0}" == 1 ]]; then
  printf '=;eth0;IPv4;Elgato\\032Key\\032Light\\032T\\065ST;_elg._tcp;local;test.local;10.0.0.10;9123;"id=discovery-1"\n'
elif [[ "${KEYLIGHT_TEST_MANY:-0}" == 1 ]]; then
  for number in {10..21}; do
    printf '=;eth0;IPv4;Elgato\\032Key\\032Light\\032%s;_elg._tcp;local;test%s.local;10.0.0.%s;9123;"id=discovery-%s"\n' \
      "$number" "$number" "$number" "$number"
  done
else
  printf '=;eth0;IPv4;Elgato\\032Key\\032Light\\032TEST;_elg._tcp;local;test.local;10.0.0.10;9123;"id=discovery-1"\n'
fi
EOF

cat >"$fake_bin/curl" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
method=GET
payload=''
output=''
max_filesize=unset
url=''
while (( $# > 0 )); do
  case "$1" in
    --request) method="$2"; shift 2 ;;
    --data) payload="$2"; shift 2 ;;
    --max-filesize) max_filesize="$2"; shift 2 ;;
    --output) output="$2"; shift 2 ;;
    http://*) url="$1"; shift ;;
    *) shift ;;
  esac
done

[[ "$max_filesize" == 65536 ]] || exit 63
[[ "$url" =~ ^http://10\.0\.0\.(1[0-9]|2[01]):9123/ || "$url" == http://192.168.62.1:9123/* ]] || exit 28
if [[ -n "$output" ]]; then
  [[ -f "$output" ]] || exit 23
  exec >"$output"
fi
if [[ -n "${KEYLIGHT_TEST_CURL_DELAY:-}" ]]; then sleep "$KEYLIGHT_TEST_CURL_DELAY"; fi
if [[ -n "${KEYLIGHT_TEST_CONCURRENCY_DIR:-}" ]]; then
  exec 9>>"$KEYLIGHT_TEST_CONCURRENCY_DIR/lock"
  flock 9
  active="$(<"$KEYLIGHT_TEST_CONCURRENCY_DIR/active")"
  peak="$(<"$KEYLIGHT_TEST_CONCURRENCY_DIR/peak")"
  active=$((active + 1))
  printf '%s\n' "$active" >"$KEYLIGHT_TEST_CONCURRENCY_DIR/active"
  (( active <= peak )) || printf '%s\n' "$active" >"$KEYLIGHT_TEST_CONCURRENCY_DIR/peak"
  flock -u 9
  sleep 0.05
  flock 9
  active="$(<"$KEYLIGHT_TEST_CONCURRENCY_DIR/active")"
  printf '%s\n' "$((active - 1))" >"$KEYLIGHT_TEST_CONCURRENCY_DIR/active"
  flock -u 9
fi
if [[ "$url" == http://192.168.62.1:9123/* ]]; then
  printf 'accessory-check\n' >>"$KEYLIGHT_TEST_SETUP_LOG"
  [[ "${KEYLIGHT_TEST_ACCESSORY:-ok}" != fail ]] || exit 22
fi
case "$url" in
  */elgato/accessory-info)
    if [[ "${KEYLIGHT_TEST_MANY:-0}" == 1 ]]; then
      serial="${url#http://10.0.0.}"
      serial="SERIAL-${serial%%:*}"
    else
      serial='SERIAL-1'
    fi
    printf '{"productName":"Elgato Key Light","serialNumber":"%s","features":["lights"]}\n' "$serial"
    ;;
  */elgato/lights)
    if [[ "$method" == PUT ]]; then
      next="$(jq -cn --argjson current "$(<"$KEYLIGHT_TEST_STATE")" --argjson payload "$payload" \
        '$current * $payload.lights[0]')"
      printf '%s\n' "$next" >"$KEYLIGHT_TEST_STATE"
    fi
    if [[ "${KEYLIGHT_TEST_OMIT_TEMPERATURE:-0}" == 1 ]]; then
      jq -cn --argjson state "$(<"$KEYLIGHT_TEST_STATE")" '{numberOfLights:1,lights:[($state | del(.temperature))]}'
    else
      jq -cn --argjson state "$(<"$KEYLIGHT_TEST_STATE")" '{numberOfLights:1,lights:[$state]}'
    fi
    ;;
  *) exit 22 ;;
esac
EOF

cat >"$fake_bin/nmcli" <<'EOF'
#!/usr/bin/env bash
if [[ "${KEYLIGHT_TEST_SETUP:-0}" != 1 ]]; then
  [[ "$*" == '-t --escape no -f SSID device wifi list --rescan no' ]]
  exit
fi
case "$*" in
  '-t -f DEVICE,TYPE device status') printf 'wlan0:wifi\n' ;;
  'device wifi rescan ifname wlan0') ;;
  '-t --escape no -f SSID,SIGNAL device wifi list ifname wlan0 --rescan yes')
    printf 'Elgato Key Light TEST:90\n'
    if [[ "${KEYLIGHT_TEST_TWO_NETWORKS:-0}" == 1 ]]; then
      printf 'Elgato Ring Light SECOND:75\n'
    fi
    ;;
  '-g GENERAL.CON-UUID device show wlan0')
    case "$(<"$KEYLIGHT_TEST_NM_STATE")" in
      light) printf 'TEMP-UUID\n' ;;
      created) printf '%s\n' '--' ;;
      *) printf 'PREV-UUID\n' ;;
    esac
    ;;
  '-t -f UUID connection show')
    printf 'PREV-UUID\n'
    [[ "$(<"$KEYLIGHT_TEST_NM_STATE")" == previous ]] || printf 'TEMP-UUID\n'
    ;;
  '-t --escape no -f UUID,NAME connection show')
    printf 'PREV-UUID:Home\n'
    if [[ "$(<"$KEYLIGHT_TEST_NM_STATE")" != previous ]]; then
      if [[ "${KEYLIGHT_TEST_PROFILE_RENAMED:-0}" == 1 ]]; then
        printf 'TEMP-UUID:Elgato Key Light TEST 1\n'
      else
        printf 'TEMP-UUID:Elgato Key Light TEST\n'
      fi
    fi
    ;;
  '-g 802-11-wireless.ssid connection show uuid TEMP-UUID')
    printf 'Elgato Key Light TEST\n'
    ;;
  '--wait 20 device wifi connect Elgato Key Light TEST ifname wlan0')
    if [[ "${KEYLIGHT_TEST_CONNECT:-ok}" == fail ]]; then
      printf 'created\n' >"$KEYLIGHT_TEST_NM_STATE"
      exit 10
    fi
    printf 'light\n' >"$KEYLIGHT_TEST_NM_STATE"
    ;;
  '--wait 20 connection up uuid PREV-UUID ifname wlan0')
    printf 'restore\n' >>"$KEYLIGHT_TEST_NM_LOG"
    printf 'previous\n' >"$KEYLIGHT_TEST_NM_STATE"
    ;;
  '--wait 10 connection delete uuid TEMP-UUID')
    printf 'delete\n' >>"$KEYLIGHT_TEST_NM_LOG"
    ;;
  *) printf 'unexpected nmcli call: %s\n' "$*" >&2; exit 1 ;;
esac
exit 0
EOF

cat >"$fake_bin/zenity" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
list=false
entry=false
for argument in "$@"; do
  if [[ "$argument" == --list ]]; then list=true; fi
  if [[ "$argument" == --entry ]]; then entry=true; fi
  if [[ "$argument" == --question ]]; then
    printf 'http-confirmation\n' >>"$KEYLIGHT_TEST_SETUP_LOG"
    [[ "${KEYLIGHT_TEST_CONFIRM:-allow}" != deny ]] || exit 1
  fi
  if [[ "$argument" == --text=Enter\ the\ destination* && "${KEYLIGHT_TEST_ZENITY_WAIT:-0}" == 1 ]]; then
    : >"$KEYLIGHT_TEST_SIGNAL_READY"
    trap 'exit 143' TERM
    while true; do sleep 0.1; done
  fi
done
if [[ "$entry" == true ]]; then
  printf '%s\n' "${KEYLIGHT_TEST_RENAME:-Renamed Light}"
fi
if [[ "$list" == true ]]; then
  mapfile -t cells
  if [[ "${KEYLIGHT_TEST_ZENITY_VALIDATE:-0}" == 1 ]]; then
    [[ "${#cells[@]}" == 4 ]]
    [[ "${cells[0]}" == 'Elgato Key Light TEST' && "${cells[1]}" == 90 ]]
    [[ "${cells[2]}" == 'Elgato Ring Light SECOND' && "${cells[3]}" == 75 ]]
  fi
  printf '%s\n' "${KEYLIGHT_TEST_ZENITY_SELECTION:-${cells[0]}}"
fi
exit 0
EOF

